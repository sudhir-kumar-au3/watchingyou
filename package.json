{
  "name": "watchingyou",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive algorithm & data-structure visualizer with deterministic, reversible playback.",
  "author": "Sudhir Kumar (https://github.com/sudhir-kumar-au3)",
  "repository": {
    "type": "git",
    "url": "https://github.com/sudhir-kumar-au3/watchingyou.git"
  },
  "homepage": "https://sudhir-kumar-au3.github.io/watchingyou/",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:root": "tsc -b && DEPLOY_BASE=/ vite build --outDir dist-root",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "verify": "npm run build:root && node scripts/verify.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "acorn": "^8.16.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.0",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^20.19.41",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.11.0",
    "playwright-core": "^1.60.0",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.9",
    "vitest": "^2.1.9"
  }
}
